# Use tabs instead of 4 spaces
--entab-leading-whitespace=4

--maximum-line-length=100

# Keep opening braces on same line
--no-opening-sub-brace-on-new-line
--no-opening-brace-on-new-line

# Modify files in-place without creating .bak files
--backup-and-modify-in-place
--backup-file-extension=/

--nostandard-output
--standard-error-output

# Put string concatenation dots at end of line
--want-break-after="."
